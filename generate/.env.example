# Copy to .env
#
# PAREVAL_MODEL_ROOTS: colon-separated dirs searched for local model weights.
# resolve_model_path() (utils.py) looks for <root>/<id>, or <root>/<subpath>
# when models.txt gives a subpath. If nothing matches, the id goes to the HF hub.
export PAREVAL_MODEL_ROOTS="/path/to/models:/path/to/other/models"
